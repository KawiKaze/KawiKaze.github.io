@inherits LayoutComponentBase
@using MudBlazor
@using AlikathWeb.Theme

<MudThemeProvider Theme="SiteTheme.Value" />

<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="1">
        <MudText Color="Color.Secondary" Typo="Typo.h5" Class="ml-3 absolute">Alikath</MudText>
        <MudSpacer />
        <MudGrid Justify="Justify.Center" Spacing="3">
            <MudItem>
                <MudButton Variant="Variant.Text" Href="/">Home</MudButton>
            </MudItem>
            <MudItem>
                <MudButton Variant="Variant.Text" Href="/Counter">Counter</MudButton>
            </MudItem>
            <MudItem>
                <MudButton Variant="Variant.Text" Href="/Weather">Weather</MudButton>
            </MudItem>
        </MudGrid>
    </MudAppBar>
    <MudMainContent>
        @Body
    </MudMainContent>
</MudLayout>    