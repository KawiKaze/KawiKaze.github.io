@page "/planday"
@using Heron.MudCalendar
@using MudBlazor
@using Ical.Net
@using Ical.Net.CalendarComponents
@inject HttpClient Http
@inject IDialogService DialogService

<PageTitle>Planday</PageTitle>

<MudCalendar Style="height: 100%; background-color: rgba(242, 242, 242, 1) !important;"
             T="CalendarItem"
             Items="_events"
             ItemClicked="ItemClicked"
             ShowTodayButton
             ShowDay="false" />

@code {
    private List<CalendarItem> _events = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadSchedule();
    }

    private async Task LoadSchedule()
    {
        try
        {
            var icsText = await Http.GetStringAsync("data/Avtal.ics");
            ParseIcs(icsText);
        }
        catch (Exception ex)
        {
            Console.WriteLine("Failed to load Avtal.ics: " + ex.Message);
        }
    }

    private void ParseIcs(string icsText)
    {
        _events.Clear();

        var calendar = Calendar.Load(icsText);

        foreach (var evt in calendar.Events)
        {
            if (evt.DtStart == null || evt.DtEnd == null) continue;

            _events.Add(new CalendarItem
            {
                Start = evt.DtStart.Value,
                End = evt.DtEnd.Value
            });
        }

        StateHasChanged();
    }

    private async Task ItemClicked(CalendarItem item)
    {
        var time = $"{item.Start:HH:mm} – {item.End:HH:mm}";
        DialogService.ShowMessageBox("Work Shift", $"{item.Start:dddd, MMMM d} | {time}");
    }
}